# Secrets — the GitHub token lives in secrets.ini (project folder), never committed.
secrets.ini

# Downloaded app icons (img/ fills itself at runtime).
img/.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment (created inside the app by the installers).
env/
venv/
.venv/

# Update scratch space
etc/update.json
etc/~tmp/
etc/.tmp/

# Generated shortcuts
*.lnk

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
