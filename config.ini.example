# Update Manager — configuration template.
# Copy this file to "config.ini" and adjust it. The GitHub TOKEN does NOT go here:
# it is stored separately (see README -> "Token / security"):
#   - env var UPDATEMANAGER_GITHUB_TOKEN, or
#   - secrets.ini in this project folder (gitignored).
# A token is required for PRIVATE repos (and raises the API rate limit for public ones).

[GitHub]
username = your-github-username

[UpdateManager]
# Window title shown when the app opens.
title = Update Manager
# Heading shown at the top inside the window.
heading = Application Library
# UI scale:
#   auto / blank -> automatic. On LINUX the desktop scale is read from Xft.dpi (e.g. 192 = 2.0 on
#                   GNOME/Wayland at 150 %) and applied to widgets, fonts and window size.
#                   On Windows/macOS customtkinter's own auto-DPI is used.
#   off          -> no scaling at all (1.0).
#   a number     -> force that scale (1.5, 2.0) on any OS.
ui_scale = auto
# Ask to self-update on startup when a newer release of Update Manager exists.
check_on_startup = true
# Theme: system (follow the desktop), light or dark. The theme button in the header
# switches it and remembers the choice here.
appearance = system
# Re-check every app every N minutes while the window is open (0 = never). Also in Settings.
recheck_minutes = 30
# Desktop notification when updates are found while the window is in the background.
notifications = true

# One [AppN] section per managed app. "name" must equal the GitHub repo name.
# Leave "version" empty for an app that is not installed yet (the button shows "Install").
#
# Icons (optional) are downloaded automatically from the app's repo (main branch) and shown
# even before the app is installed, so img/ fills itself — no manual copying:
#   icon_light / icon_dark = a path INSIDE the app's repo (or a full URL).
#   - Give both for a theme-aware icon (light + dark).
#   - Give only ONE (leave the other blank) and that single icon is used in ALL themes
#     (for single-colour icons).
#   - Give neither and it falls back to a hand-placed img/<name>_L.png / _D.png, else a
#     placeholder. While downloading, an animated spinner is shown.
[App1]
name = ExampleApp
version =
url = https://github.com/your-github-username/ExampleApp/releases/latest
icon_light = icon.png
icon_dark =
